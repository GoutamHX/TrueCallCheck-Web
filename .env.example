# ==============================================================================
# TrueCallCheck Web — Example Environment Configuration
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT commit real API keys or secrets to this file.
# ==============================================================================

# API Backend Base URL (Required for number lookup and notices)
REACT_APP_API_BASE_URL=https://your-api-domain.vercel.app

# Optional API Authentication Key (Leave blank if not required)
REACT_APP_API_KEY=

# Google Analytics 4 Measurement ID (Optional, e.g. G-XXXXXXXXXX)
REACT_APP_GA_MEASUREMENT_ID=

# Search Engine Console Verification Tags (Optional)
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=
